<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="36dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logoImageView"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo_prometeus"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircleImage"
        android:layout_marginBottom="24dp"
        android:contentDescription="Prometeus Logo"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prometeus"
        android:textColor="#FFFFFF"
        android:textSize="38sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Millones de canciones en Prometeus."
        android:textColor="#909090"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="56dp"
        android:textAlignment="center"
        android:textSize="14sp"/>

    <EditText
        android:id="@+id/usernameEditText"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@android:drawable/editbox_dropdown_dark_frame"
        android:hint="Nombre de usuario"
        android:textColorHint="#606060"
        android:textColor="#FFFFFF"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:inputType="text"
        android:layout_marginBottom="20dp"
        android:textSize="15sp"/>

    <Button
        android:id="@+id/loginButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="ENTRAR"
        android:backgroundTint="#1DB954"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:onClick="onLoginClick"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/guestTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTINUAR COMO INVITADO"
        android:textColor="#FFFFFF"
        android:layout_marginTop="32dp"
        android:onClick="onGuestClick"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.7"/>
</LinearLayout>
